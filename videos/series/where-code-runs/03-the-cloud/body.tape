# Where does code run? #3: the cloud
# Safe: runs in the chicanodev-vhs docker image as the demo user; nothing on the host is touched.

# ---- hidden setup ----
Hide
Type "export PS1='$ '"
Enter
Type "cd /vhs/series/where-code-runs/03-the-cloud/assets"
Enter
Type "clear"
Enter
Show

# @beat 0:00 Hook
Type "# the cloud sounds like magic"
Enter
Sleep 1s
Type "# it isn't"
Enter
Sleep 1.27s

# @beat 0:05 Definition
Type "clear"
Enter
Sleep 0.3s
Type "# the cloud ="
Enter
Sleep 1s
Type "# someone else's computers"
Enter
Sleep 3s
Sleep 2.62s

# @beat 0:15 Levels
Type "clear"
Enter
Sleep 0.3s
Type "cat cloud.txt"
Enter
Sleep 12s
Sleep 7.44s

# @beat 0:36 Recap
Type "clear"
Enter
Sleep 0.3s
Type "cat recap.txt"
Enter
Sleep 12s
Sleep 4.44s

# @beat 0:54 Why
Type "clear"
Enter
Sleep 0.3s
Type "# pay as you go"
Enter
Sleep 1.5s
Type "# scale in minutes"
Enter
Sleep 1.5s
Type "# the bill can surprise you"
Enter
Sleep 4.15s

# @beat 1:06 CTA
Type "clear"
Enter
Sleep 0.3s
Type "# subscribe for more"
Enter
Sleep 1s
Type "# chicanodev.com"
Enter
Sleep 3.83s
