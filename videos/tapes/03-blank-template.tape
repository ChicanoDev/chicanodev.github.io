# Copy this file and replace the example commands.
# Keep tutorials short, readable, and reproducible.
Output recordings/03-blank-template.mp4
Set Shell "bash"
Set Theme "Dracula"
Set FontSize 22
Set Width 1280
Set Height 720
Set TypingSpeed 60ms

Type "clear"
Enter
Type "echo 'YOUR TUTORIAL TITLE'"
Enter
Sleep 1s

# Add your commands below:
Type "echo 'One concept at a time.'"
Enter
Sleep 2s

Type "echo 'chicanodev.com'"
Enter
Sleep 2s
