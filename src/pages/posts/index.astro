---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
const description = 'Linux, DevOps, programming, and AI automation articles from ChicanoDev.';
---

<Base title="Articles" description={description}>
  <h1>Articles</h1>
  <p class="lede">Practical notes from the terminal, the cluster, and the work in between.</p>
  {posts.length > 0 ? (
    <div class="card-list block-gap">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  ) : (
    <p class="empty">No articles yet.</p>
  )}
</Base>
