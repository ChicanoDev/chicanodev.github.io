---
const path = Astro.url.pathname;
const items = [
  { href: '/', label: 'Home' },
  { href: '/posts/', label: 'Articles' },
  { href: '/categories/', label: 'Topics' },
  { href: '/about/', label: 'About' },
];

function current(href: string): 'page' | undefined {
  if (href === '/') return path === '/' ? 'page' : undefined;
  return path === href || path.startsWith(href) ? 'page' : undefined;
}
---

<header class="site-header wrap">
  <a class="wordmark" href="/">
    <svg class="bat" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path fill="currentColor" d="M12 5.5C11 6.8 10.2 7.2 9.2 7.2L7 5 6.6 8.6C4.6 8 2.6 8.8 1 10.6 2.6 10.4 3.8 11 4.6 12.2 5.4 11.4 6.4 11.2 7.4 11.6 8 12.6 9 13 10 13 10.8 14.2 11.4 15.4 12 18Z"></path>
      <path fill="currentColor" d="M12 5.5C11 6.8 10.2 7.2 9.2 7.2L7 5 6.6 8.6C4.6 8 2.6 8.8 1 10.6 2.6 10.4 3.8 11 4.6 12.2 5.4 11.4 6.4 11.2 7.4 11.6 8 12.6 9 13 10 13 10.8 14.2 11.4 15.4 12 18Z" transform="matrix(-1 0 0 1 24 0)"></path>
    </svg>
    <span>Chicano<span class="wordmark-accent">Dev</span></span>
  </a>
  <nav class="site-nav" aria-label="Primary">
    <ul class="nav-list">
      {items.map((item) => (
        <li>
          <a href={item.href} aria-current={current(item.href)}>{item.label}</a>
        </li>
      ))}
    </ul>
    <button
      class="theme-toggle"
      type="button"
      data-theme-toggle
      aria-label="Switch to light mode"
    >
      <svg class="theme-icon theme-when-dark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="4" fill="currentColor"></circle>
        <path
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          d="M12 3.25v2.1M12 18.65v2.1M4.75 12h2.1M17.15 12h2.1M6.2 6.2l1.5 1.5M16.3 16.3l1.5 1.5M17.8 6.2l-1.5 1.5M7.7 16.3l-1.5 1.5"
        ></path>
      </svg>
      <svg class="theme-icon theme-when-light" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          fill="currentColor"
          d="M14.8 3.2a8.8 8.8 0 1 0 6 14.5 7.1 7.1 0 1 1-6-14.5z"
        ></path>
      </svg>
    </button>
  </nav>
</header>
